# ============ Database ============
DATABASE_URL="postgresql://user:password@localhost:5432/plataforma_inss?schema=public"

# ============ Auth ============
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="gere-um-segredo-forte-com-openssl-rand-base64-32"

# ============ Cron (sweeper de geração) ============
CRON_SECRET="gere-com-openssl-rand-base64-32"

# ============ Anthropic (motor de IA) ============
ANTHROPIC_API_KEY="sk-ant-..."

# ============ Pagamento — ordem de preferência: InfinitePay > Stripe > modo dev ============
# InfinitePay (sem chave secreta — só a handle/InfiniteTag, sem o $ do início)
INFINITEPAY_HANDLE=""

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# ============ Preço do recurso (em centavos, BRL) ============
# --- Mercado Pago (checkout dentro do site) -------------------------------
# Painel: mercadopago.com.br/developers > Suas integrações > sua aplicação
# Enquanto estas três estiverem vazias, o checkout cai para a InfinitePay.
MERCADOPAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
# Webhooks > Configurar notificação > revelar chave secreta
MERCADOPAGO_WEBHOOK_SECRET=

# Valor cobrado (base enviada ao provedor) = preço no Pix
PRICE_RECURSO_CENTS=28100
# Valor anunciado no cartão à vista (base + repasse da taxa da InfinitePay)
PRICE_CARD_CENTS=29900

# ============ Storage ============
# Modo disco: caminho onde os arquivos gerados são gravados. Em produção precisa
# apontar para um volume persistente (ex.: volume da Railway montado em /data),
# senão os arquivos somem a cada deploy. Em dev, pode deixar vazio (usa ./uploads).
UPLOAD_DIR=""

# Modo S3 (opcional) — se preenchido, tem prioridade sobre o modo disco acima.
S3_ENDPOINT="https://s3.amazonaws.com"
S3_REGION="sa-east-1"
S3_BUCKET="recurso-facil"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ============ App ============
APP_URL="http://localhost:3000"
ADMIN_EMAIL="admin@recursofacil.com.br"
# Senha de admin — gere com: openssl rand -base64 18
ADMIN_PASSWORD=""

# ============ Tracking / Analytics ============
# Meta Pixel (Facebook/Instagram Ads)
NEXT_PUBLIC_META_PIXEL_ID=""
# Google Tag Manager
NEXT_PUBLIC_GTM_ID=""
# Google Analytics 4
NEXT_PUBLIC_GA4_ID=""

# ============ Suporte ============
# E-mail de contato exibido no site e usado pela assistente. Sem isso, usa contato@recursofacil.com.
NEXT_PUBLIC_SUPPORT_EMAIL="contato@recursofacil.com"

# ============ WhatsApp (botão flutuante) ============
# Formato internacional sem + nem espaços: 5511999999999
NEXT_PUBLIC_WHATSAPP_PHONE="5511999999999"
NEXT_PUBLIC_WHATSAPP_MESSAGE="Olá! Vi o site e tenho uma dúvida sobre o recurso do INSS."

# ============ E-mail (Resend) ============
# Sem chave, e-mails (aviso de novo pedido, recurso pronto, cupom de abandono) só logam, não enviam.
RESEND_API_KEY=""
# Domínio precisa estar verificado no Resend para usar um From customizado.
EMAIL_FROM="Recurso Fácil <onboarding@resend.dev>"

# ============ Observabilidade (Sentry) ============
# Sem DSN, o Sentry fica desligado (no-op) e nada muda no comportamento do app.
NEXT_PUBLIC_SENTRY_DSN=""
# Opcionais — só usados para upload de source maps no build (stack traces legíveis).
# Sem eles, o build funciona normalmente, só sem source maps no Sentry.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# --- IA (Sofia e analisador de indeferimento) ---------------------------
# Basta UM dos dois. Anthropic tem prioridade se os dois existirem.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
