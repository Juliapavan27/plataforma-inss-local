// Prisma schema — plataforma-inss

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========= USUÁRIOS & AUTH =========
// role: "USER" | "ADMIN"

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  cpf           String?   @unique
  phone         String?

  // Endereço: entra na qualificação do recorrente na peça e é enviado ao
  // checkout, o que evita o cliente ter que preenchê-lo lá.
  cep           String?
  street        String?
  number        String?
  complement    String?
  neighborhood  String?
  city          String?
  state         String?

  role          String    @default("USER")

  /// Quando a pessoa definiu a própria senha. Fica nulo para quem comprou sem
  /// criar conta: nesses casos o cadastro nasce com senha aleatória, que ela
  /// nunca viu — e por isso não adianta mandá-la para a tela de login.
  passwordSetAt DateTime?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  appeals     Appeal[]
  sessions    Session[]
  payments    Payment[]
  resetTokens PasswordResetToken[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ========= DOMÍNIO: RECURSOS =========
// benefitType: "APOSENTADORIA_IDADE" | "APOSENTADORIA_TEMPO" | "APOSENTADORIA_INVALIDEZ"
//            | "APOSENTADORIA_ESPECIAL" | "AUXILIO_DOENCA" | "AUXILIO_ACIDENTE"
//            | "BPC_LOAS" | "PENSAO_MORTE" | "SALARIO_MATERNIDADE" | "OUTRO"
// denialReason: "NAO_CUMPRIMENTO_CARENCIA" | "FALTA_QUALIDADE_SEGURADO" | "AUSENCIA_INCAPACIDADE"
//             | "TEMPO_CONTRIBUICAO_INSUFICIENTE" | "RENDA_FAMILIAR_SUPERIOR"
//             | "VINCULO_NAO_COMPROVADO" | "DOC_INSUFICIENTE" | "OUTRO"
// status: "DRAFT" | "AWAITING_PAYMENT" | "PAID" | "GENERATING" | "READY" | "FAILED" | "CANCELED"

model Appeal {
  id              String   @id @default(cuid())
  userId          String
  status          String   @default("DRAFT")

  benefitType     String
  denialReason    String
  denialDate      DateTime?
  beneficioNumero String?
  inssProtocolo   String?
  caseSummary     String
  extraFactsJson  String?  // JSON-encoded Record<string, unknown>

  // CDC art. 49 — direito de arrependimento (7 dias corridos, compra fora do estabelecimento).
  // true = cliente abriu mão do prazo e recebe em até 24h; false = mantém o direito, recebe em até 8 dias.
  withdrawalWaived Boolean  @default(false)
  dueAt            DateTime?

  generatedText   String?
  pdfUrl          String?
  docxUrl         String?
  successScore    Int?
  scoreRationale  String?
  suggestionsJson String?  // JSON-encoded string[]

  generationError String?
  generatedAt     DateTime?
  canceledAt      DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents     Document[]
  payment       Payment?
  refundRequest RefundRequest?

  @@index([userId])
  @@index([status])
}

// ========= REEMBOLSO =========
// status: "REQUESTED" | "APPROVED" | "REJECTED"

model RefundRequest {
  id           String    @id @default(cuid())
  appealId     String    @unique
  reason       String
  status       String    @default("REQUESTED")
  decisionNote String?
  requestedAt  DateTime  @default(now())
  decidedAt    DateTime?

  appeal Appeal @relation(fields: [appealId], references: [id], onDelete: Cascade)

  @@index([status])
}

model Document {
  id         String   @id @default(cuid())
  appealId   String
  filename   String
  mimeType   String
  sizeBytes  Int
  storageUrl String
  kind       String
  createdAt  DateTime @default(now())

  appeal Appeal @relation(fields: [appealId], references: [id], onDelete: Cascade)

  @@index([appealId])
}

// ========= PAGAMENTOS =========
// status: "PENDING" | "PAID" | "FAILED" | "REFUNDED"
// provider: "stripe" | "infinitepay"

model Payment {
  id                  String    @id @default(cuid())
  userId              String
  appealId            String    @unique
  amountCents         Int
  currency            String    @default("BRL")
  status              String    @default("PENDING")
  provider            String    @default("stripe")
  stripeSessionId     String?   @unique
  stripePaymentIntent String?
  infinitepayTransactionNsu String?
  infinitepaySlug           String?
  mercadopagoOrderId        String?
  mercadopagoPaymentId      String?
  /// "pix" ou "credit_card" — escolhido pelo cliente na nossa página de pagamento.
  paymentMethod             String?
  /// Desconto de recuperação de carrinho, em centavos. 0 = sem desconto.
  discountCents             Int      @default(0)

  // Nota fiscal de serviço (NFS-e), emitida manualmente na prefeitura.

  /// PENDENTE | EMITIDA | CANCELAR | CANCELADA | DISPENSADA
  /// CANCELAR marca nota já emitida cujo pedido foi cancelado ou reembolsado:
  /// sem cancelar na prefeitura, fica imposto pago sobre venda desfeita.
  nfStatus                  String    @default("PENDENTE")
  nfNumero                  String?
  nfEmitidaEm               DateTime?
  nfObservacao              String?
  paidAt              DateTime?
  abandonedEmailSentAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  appeal Appeal @relation(fields: [appealId], references: [id], onDelete: Cascade)

  // Índice em vez de @unique: adicionar constraint única numa tabela que já tem
  // linhas faz o `prisma db push` do pre-deploy exigir --accept-data-loss, e essa
  // trava existe de propósito. Só precisamos achar o pedido pelo id da order.
  @@index([mercadopagoOrderId])
}

// ========= PRODUTOS DIGITAIS: MANUAIS =========
// Esteira de entrada: quem busca "como recorrer do INSS" (intenção de dúvida,
// não de compra) leva um manual em PDF por R$ 9,90 em vez de bater na venda de
// R$ 299. Deliberadamente NÃO reaproveita Payment/Appeal: aquele par é casado
// 1-a-1 (Payment.appealId é único e obrigatório) e representa um serviço sob
// medida; o manual é um produto fixo, igual para todos, comprado só com
// nome+e-mail. Tabela própria e aditiva evita mexer no schema de produção.
//
// status: "PENDING" | "PAID" | "FAILED"
model ManualOrder {
  id                   String    @id @default(cuid())
  /// Qual manual foi comprado — casa com o slug em src/content/manuais.ts.
  manualSlug           String
  buyerName            String
  buyerEmail           String
  amountCents          Int       @default(990)
  currency             String    @default("BRL")
  status               String    @default("PENDING")
  provider             String    @default("mercadopago")
  mercadopagoOrderId   String?
  mercadopagoPaymentId String?
  /// Só "pix" por enquanto — ninguém parcela R$ 9,90.
  paymentMethod        String?
  paidAt               DateTime?
  /// Quando o e-mail com o link de entrega saiu — evita reenviar a cada webhook.
  deliveredAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([manualSlug])
  @@index([mercadopagoOrderId])
  @@index([status])
}

// ========= BASE DE CONHECIMENTO (RAG) =========
// kind: "JURISPRUDENCIA" | "DOUTRINA" | "LEGISLACAO" | "MODELO_RECURSO" | "OUTRO"

model KnowledgeEntry {
  id        String   @id @default(cuid())
  title     String
  kind      String
  content   String
  sourceUrl String?
  tagsJson  String   @default("[]") // JSON string[]
  fileUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chunks KnowledgeChunk[]
}

model KnowledgeChunk {
  id            String   @id @default(cuid())
  entryId       String
  content       String
  position      Int
  embeddingJson String   @default("[]") // JSON float[]
  createdAt     DateTime @default(now())

  entry KnowledgeEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId])
}

// ========= LOGS =========

model GenerationLog {
  id           String   @id @default(cuid())
  appealId     String
  phase        String
  model        String?
  promptTokens Int?
  outputTokens Int?
  durationMs   Int?
  success      Boolean
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([appealId])
}

/// Token de definição/redefinição de senha, enviado por e-mail.
/// Guarda só o hash: quem tiver acesso ao banco não consegue usar o link.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
