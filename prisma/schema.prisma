// Prisma schema — plataforma-inss

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========= USUÁRIOS & AUTH =========
// role: "USER" | "ADMIN"

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  cpf           String?   @unique
  phone         String?
  role          String    @default("USER")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  appeals  Appeal[]
  sessions Session[]
  payments Payment[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ========= DOMÍNIO: RECURSOS =========
// benefitType: "APOSENTADORIA_IDADE" | "APOSENTADORIA_TEMPO" | "APOSENTADORIA_INVALIDEZ"
//            | "APOSENTADORIA_ESPECIAL" | "AUXILIO_DOENCA" | "AUXILIO_ACIDENTE"
//            | "BPC_LOAS" | "PENSAO_MORTE" | "SALARIO_MATERNIDADE" | "OUTRO"
// denialReason: "NAO_CUMPRIMENTO_CARENCIA" | "FALTA_QUALIDADE_SEGURADO" | "AUSENCIA_INCAPACIDADE"
//             | "TEMPO_CONTRIBUICAO_INSUFICIENTE" | "RENDA_FAMILIAR_SUPERIOR"
//             | "VINCULO_NAO_COMPROVADO" | "DOC_INSUFICIENTE" | "OUTRO"
// status: "DRAFT" | "AWAITING_PAYMENT" | "PAID" | "GENERATING" | "READY" | "FAILED" | "CANCELED"

model Appeal {
  id              String   @id @default(cuid())
  userId          String
  status          String   @default("DRAFT")

  benefitType     String
  denialReason    String
  denialDate      DateTime?
  beneficioNumero String?
  inssProtocolo   String?
  caseSummary     String
  extraFactsJson  String?  // JSON-encoded Record<string, unknown>

  // CDC art. 49 — direito de arrependimento (7 dias corridos, compra fora do estabelecimento).
  // true = cliente abriu mão do prazo e recebe em até 24h; false = mantém o direito, recebe em até 8 dias.
  withdrawalWaived Boolean  @default(false)
  dueAt            DateTime?

  generatedText   String?
  pdfUrl          String?
  docxUrl         String?
  successScore    Int?
  scoreRationale  String?
  suggestionsJson String?  // JSON-encoded string[]

  generationError String?
  generatedAt     DateTime?
  canceledAt      DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents     Document[]
  payment       Payment?
  refundRequest RefundRequest?

  @@index([userId])
  @@index([status])
}

// ========= REEMBOLSO =========
// status: "REQUESTED" | "APPROVED" | "REJECTED"

model RefundRequest {
  id           String    @id @default(cuid())
  appealId     String    @unique
  reason       String
  status       String    @default("REQUESTED")
  decisionNote String?
  requestedAt  DateTime  @default(now())
  decidedAt    DateTime?

  appeal Appeal @relation(fields: [appealId], references: [id], onDelete: Cascade)

  @@index([status])
}

model Document {
  id         String   @id @default(cuid())
  appealId   String
  filename   String
  mimeType   String
  sizeBytes  Int
  storageUrl String
  kind       String
  createdAt  DateTime @default(now())

  appeal Appeal @relation(fields: [appealId], references: [id], onDelete: Cascade)

  @@index([appealId])
}

// ========= PAGAMENTOS =========
// status: "PENDING" | "PAID" | "FAILED" | "REFUNDED"
// provider: "stripe" | "infinitepay"

model Payment {
  id                  String    @id @default(cuid())
  userId              String
  appealId            String    @unique
  amountCents         Int
  currency            String    @default("BRL")
  status              String    @default("PENDING")
  provider            String    @default("stripe")
  stripeSessionId     String?   @unique
  stripePaymentIntent String?
  infinitepayTransactionNsu String?
  infinitepaySlug           String?
  paidAt              DateTime?
  abandonedEmailSentAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  appeal Appeal @relation(fields: [appealId], references: [id], onDelete: Cascade)
}

// ========= BASE DE CONHECIMENTO (RAG) =========
// kind: "JURISPRUDENCIA" | "DOUTRINA" | "LEGISLACAO" | "MODELO_RECURSO" | "OUTRO"

model KnowledgeEntry {
  id        String   @id @default(cuid())
  title     String
  kind      String
  content   String
  sourceUrl String?
  tagsJson  String   @default("[]") // JSON string[]
  fileUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chunks KnowledgeChunk[]
}

model KnowledgeChunk {
  id            String   @id @default(cuid())
  entryId       String
  content       String
  position      Int
  embeddingJson String   @default("[]") // JSON float[]
  createdAt     DateTime @default(now())

  entry KnowledgeEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId])
}

// ========= LOGS =========

model GenerationLog {
  id           String   @id @default(cuid())
  appealId     String
  phase        String
  model        String?
  promptTokens Int?
  outputTokens Int?
  durationMs   Int?
  success      Boolean
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([appealId])
}
